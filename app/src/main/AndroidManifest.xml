<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Declare visibility for Health Connect & Wearable Companion Apps -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.fitbit.FitbitMobile" />
        <package android:name="com.sec.android.app.shealth" />
        <package android:name="com.samsung.android.app.watchmanager" />
        <package android:name="com.samsung.android.shealthmonitor" />
        <package android:name="com.ouraring.oura" />
        <package android:name="com.ultrahuman" />
        <package android:name="com.gabit.app" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="com.mediatek.wwsync.noise" />
        <package android:name="com.coveiot.boatus" />
        <package android:name="com.huami.midong" />
        <package android:name="nl.appyhapps.healthsync" />
    </queries>

    <!-- Health Connect Read Permissions -->
    <!-- Dual declarations: Framework permissions (Android 14+) and Jetpack APK permissions (Android <= 13) -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!-- Activity & Movement -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="androidx.health.permission.StepsRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="androidx.health.permission.DistanceRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_SPEED" />
    <uses-permission android:name="androidx.health.permission.SpeedRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="androidx.health.permission.ActiveCaloriesBurnedRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="androidx.health.permission.TotalCaloriesBurnedRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />
    <uses-permission android:name="androidx.health.permission.ElevationGainedRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="androidx.health.permission.FloorsClimbedRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_STEPS_CADENCE" />
    <uses-permission android:name="androidx.health.permission.StepsCadenceRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="androidx.health.permission.ExerciseSessionRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_WHEELCHAIR_PUSHES" />
    <uses-permission android:name="androidx.health.permission.WheelchairPushesRecord.READ" />

    <!-- Clinical Vitals -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="androidx.health.permission.HeartRateRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="androidx.health.permission.RestingHeartRateRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="androidx.health.permission.HeartRateVariabilityRmssdRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" />
    <uses-permission android:name="androidx.health.permission.Vo2MaxRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <uses-permission android:name="androidx.health.permission.BloodPressureRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" />
    <uses-permission android:name="androidx.health.permission.BloodGlucoseRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="androidx.health.permission.OxygenSaturationRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" />
    <uses-permission android:name="androidx.health.permission.BodyTemperatureRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" />
    <uses-permission android:name="androidx.health.permission.BasalBodyTemperatureRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_SKIN_TEMPERATURE" />
    <uses-permission android:name="androidx.health.permission.SkinTemperatureRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="androidx.health.permission.RespiratoryRateRecord.READ" />

    <!-- Sleep -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="androidx.health.permission.SleepSessionRecord.READ" />

    <!-- Body Measurements -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="androidx.health.permission.WeightRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="androidx.health.permission.HeightRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="androidx.health.permission.BodyFatRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_BONE_MASS" />
    <uses-permission android:name="androidx.health.permission.BoneMassRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_LEAN_BODY_MASS" />
    <uses-permission android:name="androidx.health.permission.LeanBodyMassRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_BODY_WATER_MASS" />
    <uses-permission android:name="androidx.health.permission.BodyWaterMassRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" />
    <uses-permission android:name="androidx.health.permission.BasalMetabolicRateRecord.READ" />

    <!-- Nutrition & Hydration -->
    <uses-permission android:name="android.permission.health.READ_NUTRITION" />
    <uses-permission android:name="androidx.health.permission.NutritionRecord.READ" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />
    <uses-permission android:name="androidx.health.permission.HydrationRecord.READ" />


    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".presentation.MainActivity"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep Link for Supabase Auth -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zivaa" android:host="auth" />
            </intent-filter>
            <!-- Health Connect Permissions Intent Handler -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <!-- Health Connect Privacy Policy Intent Handler -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="zivaa.app" android:path="/privacy" />
            </intent-filter>
        </activity>

        <!-- Android 14 Health Connect Permission Usage Intent -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".presentation.MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".services.ZivaaFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".data.sensors.PhoneSensorService"
            android:foregroundServiceType="health"
            android:exported="false" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="health"
            tools:node="merge" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Default Notification Channel for Background FCM Notifications -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="zivaa_nudge_channel" />

    </application>
</manifest>
